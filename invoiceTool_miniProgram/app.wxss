/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

view, text, image {
  box-sizing: border-box;
}

.container {
  width: 100%;
  min-height: 100vh;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-primary {
  background-color: #3B5BDB;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 36rpx;
  padding: 20rpx 0;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background-color: #fff;
  color: #3B5BDB;
  border: 2rpx solid #3B5BDB;
  border-radius: 8rpx;
  font-size: 36rpx;
  padding: 20rpx 0;
  text-align: center;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  padding: 20rpx 30rpx;
}
