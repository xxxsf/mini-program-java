page { background: #f5f5f5; }

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 32rpx;
}

.title {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
  margin-top: 60rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 导入方式列表 */
.import-options {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.option-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.option-item:last-child { border-bottom: none; }

.option-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.camera-icon { background: #EEF2FF; }
.album-icon { background: #e3f2fd; }
.file-icon { background: #fff3e0; }

.option-info { flex: 1; }
.option-title {
  font-size: 36rpx;
  color: #333;
  font-weight: 500;
  display: block;
}
.option-desc {
  font-size: 30rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}
.option-arrow {
  color: #ccc;
  font-size: 28rpx;
  margin-left: 16rpx;
}

/* 说明 */
.tips-title {
  font-size: 24rpx;
  color: #999;
  margin-top: 40rpx;
  padding: 0 8rpx;
}

.tips {
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}
.dot {
  margin-right: 12rpx;
  font-weight: bold;
}

/* 已导入文件 */
.imported-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.imported-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}
.imported-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.imported-item:last-of-type { border-bottom: none; }
.imported-name {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.imported-status {
  font-size: 24rpx;
  color: #3B5BDB;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.view-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #3B5BDB;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 42rpx;
  margin-top: 24rpx;
}
.view-btn::after { border: none; }
