page { background: #fff; }

.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 48rpx;
}

.title {
  font-size: 40rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
  margin-top: 80rpx;
}

.desc {
  font-size: 30rpx;
  color: #333;
  text-align: center;
  margin-top: 40rpx;
  line-height: 1.6;
}

.tips-title {
  font-size: 26rpx;
  color: #999;
  margin-top: 80rpx;
}

.tips { margin-top: 20rpx; }

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
.dot {
  margin-right: 12rpx;
  font-weight: bold;
}

.bottom-area {
  margin-top: auto;
  padding-bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.agreement {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 24rpx;
}
.select-btn {
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  color: #07C160;
  border: 2rpx solid #07C160;
  border-radius: 12rpx;
  font-size: 32rpx;
}
