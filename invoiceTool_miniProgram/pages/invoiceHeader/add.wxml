<view class="page">
  <view class="title">填写发票抬头信息</view>

  <!-- 智能粘贴并识别区域 -->
  <view class="smart-box">
    <!-- <view class="smart-title">📋 智能解析发票抬头（支持一键粘贴拆分）</view> -->
    <textarea class="smart-input" placeholder="「粘贴识别」或输入文本，只能拆分名称、税号和单位地址等信息" value="{{smartText}}" bindinput="onSmartInput" />
    <view class="smart-btn-row">
      <button class="smart-btn" bindtap="onSmartParse">智能一键填充</button>
    </view>
  </view>

  <view class="form">
    <view class="form-row">
      <text class="form-label">名称</text>
      <input class="form-input" placeholder="抬头名称" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-row">
      <text class="form-label">税号</text>
      <input class="form-input" placeholder="纳税人识别号" value="{{taxNo}}" bindinput="onTaxInput" />
    </view>
    <view class="form-row">
      <text class="form-label">单位地址</text>
      <input class="form-input" placeholder="公司地址 (选填)" value="{{address}}" bindinput="onAddressInput" />
    </view>
    <view class="form-row">
      <text class="form-label">电话号码</text>
      <input class="form-input" placeholder="公司电话 (选填)" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-row">
      <text class="form-label">开户银行</text>
      <input class="form-input" placeholder="开户银行 (选填)" value="{{bank}}" bindinput="onBankInput" />
    </view>
    <view class="form-row">
      <text class="form-label">银行账户</text>
      <input class="form-input" placeholder="银行账户 (选填)" value="{{bankAccount}}" bindinput="onAccountInput" />
    </view>
  </view>

  <!-- 隐私政策同意区域 -->
  <view class="privacy-section">
    <view class="privacy-checkbox" bindtap="onPrivacyChange">
      <view class="checkbox {{privacyAgreed ? 'checked' : ''}}">
        <text wx:if="{{privacyAgreed}}">✓</text>
      </view>
      <view class="privacy-text">
        <text>我已阅读并同意</text>
        <text class="privacy-link" catchtap="onViewPrivacy">《隐私政策》</text>
        <text>，知晓并同意收集上述信息仅用于发票管理功能。</text>
      </view>
    </view>
  </view>

  <button class="save-btn {{name && privacyAgreed ? 'active' : ''}}" bindtap="onSave">保存</button>
</view>
