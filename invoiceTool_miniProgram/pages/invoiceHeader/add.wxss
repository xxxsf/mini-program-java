page { background: #fff; }

.page { padding: 0 48rpx; }

.title {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
  margin-top: 60rpx;
  margin-bottom: 60rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  width: 160rpx;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.form-input::placeholder {
  color: #ccc;
}

.save-btn {
  margin-top: 80rpx;
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #f5f5f5;
  color: #999;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
.save-btn.active {
  background: #3B5BDB;
  color: #fff;
}
