page { background: #fff; }

.page { padding: 0 48rpx; }

.title {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
  margin-top: 60rpx;
  margin-bottom: 60rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  width: 160rpx;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 34rpx;
  color: #333;
}
.form-input::placeholder {
  color: #ccc;
}

/* 隐私政策区域 */
.privacy-section {
  padding: 40rpx 0;
}

.privacy-checkbox {
  display: flex;
  align-items: flex-start;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #999;
  border-radius: 6rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #3B5BDB;
  border-color: #3B5BDB;
  color: #fff;
  font-size: 24rpx;
}

.privacy-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.privacy-link {
  color: #3B5BDB;
  text-decoration: underline;
}

.save-btn {
  margin-top: 80rpx;
  width: 400rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #f5f5f5;
  color: #999;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
}
.save-btn.active {
  background: #3B5BDB;
  color: #fff;
}

/* 智能识别模块样式 */
.smart-box {
  /* background: #F8F9FA; */
  /* border: 2rpx dashed #CED4DA; */
  border-radius: 16rpx;
  /* padding: 24rpx; */
  margin-bottom: 40rpx;
}
.smart-title {
  font-size: 26rpx;
  color: #495057;
  font-weight: bold;
  margin-bottom: 16rpx;
}
.smart-input {
  width: 100%;
  height: 150rpx;
  background: #fff;
  border: 1rpx solid #E9ECEF;
  border-radius: 8rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 16rpx;
}
.smart-btn-row {
  display: flex;
  justify-content: flex-end;
}
.smart-btn {
  background: linear-gradient(135deg, #4c6ef5, #3b5bdb);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  margin: 0;
  border: none;
}
.smart-btn::after {
  border: none;
}
