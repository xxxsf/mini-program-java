page { background: #f5f5f5; }

.head {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}
.head image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.form-group {
  background: #fff;
  margin: 0 24rpx;
  border-radius: 12rpx;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-row:last-child { border-bottom: none; }
.label {
  width: 140rpx;
  font-size: 30rpx;
  color: #333;
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.save-btn {
  margin: 48rpx;
  background: #3B5BDB;
  color: #fff;
  border-radius: 12rpx;
  font-size: 38rpx;
}
