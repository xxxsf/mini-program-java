page { background: #f5f5f5; }

.header {
  background: linear-gradient(135deg, #3B5BDB, #748FFC);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.6);
}
.nickname {
  color: #fff;
  font-size: 32rpx;
  margin-top: 16rpx;
}

.menu-list {
  background: #fff;
  margin: 24rpx;
  border-radius: 12rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
  color: #333;
}
.menu-item:last-child { border-bottom: none; }
.arrow { color: #ccc; font-size: 28rpx; }

.logout-area { padding: 40rpx 48rpx; }
.logout-btn {
  background: #fff;
  color: #e64340;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e64340;
}
