<view class="page">
  <view class="head">
    <image src="{{userInfo.avatarUrl}}" bindtap="dateAvatar" />
  </view>

  <form bindsubmit="formSubmit">
    <view class="form-group">
      <view class="form-row">
        <text class="label">昵称</text>
        <input class="input" name="nickName" placeholder="请输入昵称" value="{{userInfo.nickName}}" />
      </view>
      <view class="form-row">
        <text class="label">手机号</text>
        <input class="input" type="number" maxlength="11" name="phone" placeholder="请输入手机号" value="{{userInfo.phone}}" />
      </view>
      <view class="form-row">
        <text class="label">性别</text>
        <picker mode="selector" name="gender" value="{{userInfo.gender}}" range="{{sex}}" bindchange="selectsex">
          <text class="input">{{sex[userInfo.gender] || '请选择'}}</text>
        </picker>
      </view>
    </view>
    <button class="save-btn" formType="submit">保存</button>
  </form>
</view>
