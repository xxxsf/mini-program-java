page { background: #f5f5f5; }

.page { min-height: 100vh; }

/* 主题头部 */
.header {
  background: linear-gradient(135deg, #3B5BDB, #748FFC);
  padding: 40rpx 0 60rpx;
}
.actions {
  display: flex;
  justify-content: center;
  gap: 120rpx;
}
.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.action-icon {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #fff;
  line-height: 80rpx;
  text-align: center;
}
.action-img {
  width: 56rpx;
  height: 56rpx;
}
.action-label {
  color: #fff;
  font-size: 32rpx;
  margin-top: 12rpx;
}

/* 邮箱关联栏 */
.email-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.email-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}
.email-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.email-btn {
  background: #3B5BDB;
  color: #fff;
  font-size: 32rpx;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
}

/* 广告位 */
.banner {
  margin: 0 24rpx 24rpx;
  height: 200rpx;
  border: 2rpx dashed rgba(59,91,219,0.35);
  border-radius: 16rpx;
  background:
    linear-gradient(135deg, rgba(255,255,255,0.72), rgba(238,242,255,0.9)),
    repeating-linear-gradient(-45deg, rgba(59,91,219,0.08) 0, rgba(59,91,219,0.08) 12rpx, transparent 12rpx, transparent 28rpx);
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(59,91,219,0.1);
}
.banner::before {
  content: "AD SPACE";
  position: absolute;
  right: 28rpx;
  top: 20rpx;
  color: rgba(59,91,219,0.16);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.banner::after {
  content: "招租中";
  position: absolute;
  left: 28rpx;
  top: 22rpx;
  color: #3B5BDB;
  background: rgba(255,255,255,0.86);
  border: 1rpx solid rgba(59,91,219,0.18);
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}
.banner-content {
  height: 100%;
  padding: 50rpx 32rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.banner-text {
  display: flex;
  flex-direction: column;
}
.banner-title {
  color: #233876;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}
.banner-desc {
  color: #5C6F9E;
  font-size: 24rpx;
  margin-top: 10rpx;
  max-width: 390rpx;
  line-height: 1.5;
}
.banner-badge {
  color: #fff;
  background: #3B5BDB;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(59,91,219,0.22);
}

/* 发票抬头 */
.section {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}
.header-add {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.header-add-icon {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #3B5BDB;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3B5BDB;
  font-size: 32rpx;
  margin-right: 16rpx;
  line-height: 44rpx;
  text-align: center;
}
.header-add-text {
  font-size: 36rpx;
  color: #333;
}
.header-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.header-item:last-child { border-bottom: none; }
.header-info { flex: 1; }
.header-name {
  font-size: 30rpx;
  color: #333;
  display: block;
}
.header-tax {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}
.header-arrow {
  color: #ccc;
  font-size: 28rpx;
}

/* 常见问题 */
.faq {
  text-align: center;
  padding: 40rpx 0 60rpx;
}
.faq-text {
  color: #3B5BDB;
  font-size: 28rpx;
}

/* 来源弹窗 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
}
.source-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 0 32rpx 60rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.source-sheet.show { transform: translateY(0); }
.sheet-header {
  display: flex;
  align-items: flex-start;
  padding: 32rpx 0 24rpx;
}
.sheet-close {
  font-size: 40rpx;
  color: #333;
  margin-right: 24rpx;
  line-height: 1;
}
.sheet-title-wrap { flex: 1; }
.sheet-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  display: block;
}
.sheet-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}
.sheet-option {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}
.sheet-label {
  flex: 1;
  font-size: 36rpx;
  color: #333;
}
.sheet-arrow {
  color: #ccc;
  font-size: 28rpx;
}
.sheet-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 0;
  gap: 20rpx;
}
.sheet-link {
  color: #3B5BDB;
  font-size: 32rpx;
}
.sheet-sep {
  color: #ddd;
  font-size: 26rpx;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.modal-content {
  width: 580rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ced4da;
  border-radius: 8rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}
.modal-btn {
  background: #3B5BDB;
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  margin-bottom: 16rpx;
  text-align: center;
}
.modal-btn.cancel {
  background: #e9ecef;
  color: #495057;
}
.modal-btn::after {
  border: none;
}
