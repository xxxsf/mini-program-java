page { background: #f5f5f5; }

.search-bar {
  display: flex;
  align-items: center;
  background: #f0f0f0;
  margin: 20rpx 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
}
.filter-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  font-size: 26rpx;
  color: #666;
}
.filter-arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
  color: #999;
}
.batch-btn {
  margin-left: auto;
  font-size: 26rpx;
  color: #3B5BDB;
}

.banner {
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 160rpx;
}

.email-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.email-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}
.email-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.email-btn {
  background: #3B5BDB;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: 8rpx;
}

.add-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
}
.add-icon {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #3B5BDB;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3B5BDB;
  font-size: 32rpx;
  margin-right: 16rpx;
  line-height: 44rpx;
  text-align: center;
}
.add-text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.invoice-card {
  background: #fff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-tag {
  background: #EEF2FF;
  color: #3B5BDB;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex-shrink: 0; /* 防止被长文件名挤压 */
  white-space: nowrap; /* 保证标签内的字始终横向单行显示 */
}
.card-company {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; /* 太长的发票名或商户名自动截断，显示省略号 */
}
.card-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.card-label {
  font-size: 24rpx;
  color: #999;
  width: 100rpx;
}
.card-value {
  font-size: 26rpx;
  color: #333;
}
.card-value.amount {
  color: #333;
  font-weight: bold;
}

.file-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 12rpx;
}
.card-delete {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 4rpx 16rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
}
.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}

/* 批量打勾选择样式 */
.invoice-card.batch-mode {
  display: flex;
  align-items: center;
  flex-direction: row;
}
.invoice-card.selected {
  background: #f8f9ff;
  border-left: 6rpx solid #3B5BDB;
}
.check-box-wrapper {
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.uncheck-circle {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #adb5bd;
  border-radius: 50%;
  box-sizing: border-box;
}
.card-body {
  flex: 1;
  min-width: 0;
}

/* 底部批量操作工具栏 */
.bottom-batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  padding: 24rpx 32rpx env(safe-area-inset-bottom);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 100;
}
.batch-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.batch-select-all {
  display: flex;
  align-items: center;
}
.batch-select-text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-left: 16rpx;
}
.batch-count-text {
  font-size: 24rpx;
  color: #868e96;
  margin-left: 16rpx;
}
.batch-close-btn {
  font-size: 32rpx;
  color: #adb5bd;
  padding: 8rpx;
}
.batch-actions {
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #f1f3f5;
  padding-top: 16rpx;
}
.batch-action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #495057;
  gap: 8rpx;
}
.batch-action-btn.delete {
  color: #fa5252;
}
.action-icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f1f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.action-icon-circle.chat {
  background: #e8f5e9;
}
.action-icon-circle.email {
  background: #e3f2fd;
}
.action-icon-circle.trash {
  background: #ffe3e3;
}

/* 弹窗遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.modal-content {
  width: 580rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-body-text {
  font-size: 28rpx;
  color: #495057;
  line-height: 1.5;
  margin-bottom: 32rpx;
}
.modal-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ced4da;
  border-radius: 8rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  margin-bottom: 32rpx;
}
.modal-items {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 40rpx;
}
.modal-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.modal-item:last-child {
  margin-bottom: 0;
}
.modal-item-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}
.modal-item-icon.pdf {
  background: #e03131;
}
.modal-item-icon.xlsx {
  background: #2b8a3e;
}
.modal-item-title {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.modal-btn {
  background: #3B5BDB;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  margin-bottom: 16rpx;
}
.modal-btn.cancel {
  background: #e9ecef;
  color: #495057;
}
.modal-btn::after {
  border: none;
}
