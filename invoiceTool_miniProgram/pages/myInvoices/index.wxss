page { background: #f5f5f5; }

.search-bar {
  display: flex;
  align-items: center;
  background: #f0f0f0;
  margin: 20rpx 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
}
.filter-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  font-size: 26rpx;
  color: #666;
}
.filter-arrow {
  font-size: 20rpx;
  margin-left: 4rpx;
  color: #999;
}
.batch-btn {
  margin-left: auto;
  font-size: 26rpx;
  color: #3B5BDB;
}

.banner {
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 160rpx;
}

.email-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.email-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}
.email-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}
.email-btn {
  background: #3B5BDB;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: 8rpx;
}

.add-entry {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
}
.add-icon {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #3B5BDB;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3B5BDB;
  font-size: 32rpx;
  margin-right: 16rpx;
  line-height: 44rpx;
  text-align: center;
}
.add-text {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.invoice-card {
  background: #fff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
}
.card-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.card-tag {
  background: #EEF2FF;
  color: #3B5BDB;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  flex-shrink: 0; /* 防止被长文件名挤压 */
  white-space: nowrap; /* 保证标签内的字始终横向单行显示 */
}
.card-company {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap; /* 太长的发票名或商户名自动截断，显示省略号 */
}
.card-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.card-label {
  font-size: 24rpx;
  color: #999;
  width: 100rpx;
}
.card-value {
  font-size: 26rpx;
  color: #333;
}
.card-value.amount {
  color: #333;
  font-weight: bold;
}

.file-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 12rpx;
}
.card-delete {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 4rpx 16rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
}
.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 12rpx;
}
