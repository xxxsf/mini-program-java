/* pages/invoice/index/index.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部绿色区域 */
.header-area {
  background-color: #09BB07;
  padding: 30rpx 0 80rpx;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

/* 用户信息栏 */
.user-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 30rpx 30rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.user-name {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}

.logout-btn {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
}

.action-buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 120rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.action-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

.action-icon-doc {
  font-size: 44rpx;
  color: #fff;
  line-height: 1;
}

.action-text {
  font-size: 28rpx;
  color: #fff;
}

/* 邮箱关联栏 */
.email-link-bar {
  margin: 24rpx 24rpx 0;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
}

.email-icon-wrap {
  margin-right: 16rpx;
}

.email-icon {
  font-size: 40rpx;
  color: #09BB07;
}

.email-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.email-btn {
  background-color: #09BB07;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 30rpx;
  border-radius: 8rpx;
}

/* 促销横幅 */
.promo-banner {
  margin: 24rpx;
  background: linear-gradient(135deg, #09BB07, #07a006);
  border-radius: 16rpx;
  overflow: hidden;
  padding: 40rpx 30rpx;
}

.promo-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.promo-text-area {
  display: flex;
  flex-direction: column;
}

.promo-title {
  font-size: 40rpx;
  color: #fff;
  font-weight: bold;
}

.promo-subtitle {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.promo-btn {
  background-color: #FFE500;
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 36rpx;
  border-radius: 30rpx;
}

/* 发票抬头部分 */
.section-label {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 30rpx 10rpx;
}

.header-list {
  margin: 0 24rpx;
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.header-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-item:last-child {
  border-bottom: none;
}

.add-header {
  gap: 16rpx;
}

.add-icon-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #09BB07;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 36rpx;
  color: #09BB07;
  line-height: 1;
}

.add-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-name {
  font-size: 30rpx;
  color: #333;
}

.header-tax {
  font-size: 24rpx;
  color: #999;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 常见问题 */
.faq-link {
  text-align: center;
  padding: 40rpx 0;
}

.faq-text {
  font-size: 28rpx;
  color: #576B95;
}

/* 来源弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.source-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.source-modal.show {
  transform: translateY(0);
}

.modal-header {
  padding: 30rpx;
  display: flex;
  align-items: flex-start;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 0 20rpx 0 0;
  line-height: 1;
}

.modal-title-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.modal-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.source-option {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.source-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.source-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.source-bottom-links {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  gap: 20rpx;
}

.bottom-link {
  font-size: 28rpx;
  color: #576B95;
}

.bottom-divider {
  font-size: 28rpx;
  color: #ddd;
}
