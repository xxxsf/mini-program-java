/* pages/invoice/headerAdd/index.wxss */

.container {
  min-height: 100vh;
  background-color: #fff;
  padding: 0 0 40rpx;
}

.page-title {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
  padding: 60rpx 0 50rpx;
}

.form-section {
  padding: 0 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-label {
  font-size: 36rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 34rpx;
  color: #333;
}

.placeholder {
  color: #ccc;
}

/* 隐私政策区域 */
.privacy-section {
  padding: 40rpx 40rpx 0;
}

.privacy-checkbox {
  display: flex;
  align-items: flex-start;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #999;
  border-radius: 6rpx;
  margin-right: 16rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #3B5BDB;
  border-color: #3B5BDB;
  color: #fff;
  font-size: 24rpx;
}

.privacy-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.privacy-link {
  color: #3B5BDB;
  text-decoration: underline;
}

.btn-area {
  padding: 60rpx 60rpx 0;
}

.save-btn {
  width: 100%;
  background-color: #f5f5f5;
  color: #999;
  border: none;
  border-radius: 12rpx;
  font-size: 34rpx;
  padding: 24rpx 0;
  text-align: center;
}

.save-btn.active {
  background-color: #3B5BDB;
  color: #fff;
}

.save-btn::after {
  border: none;
}

.delete-area {
  text-align: center;
  padding: 40rpx 0;
}

.delete-btn {
  font-size: 40rpx;
  color: #fa5151;
}
