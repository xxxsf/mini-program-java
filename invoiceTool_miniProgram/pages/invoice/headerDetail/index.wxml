<view class="container">
  <view class="page-title">发票抬头详情</view>

  <!-- 都显示卡片 -->
  <view class="header-card" wx:if="{{header.name}}">
    <view class="card-header">
      <text class="company-name" selectable>{{header.name}}</text>
      <text class="tag">{{header.taxNo ? '企业' : '个人'}}</text>
    </view>

    <view class="info-list">
      <view class="info-item" wx:if="{{header.taxNo}}">
        <text class="label">纳税人识别号</text>
        <text class="value" selectable>{{header.taxNo}}</text>
      </view>
      <view class="info-item" wx:if="{{header.address}}">
        <text class="label">单位地址</text>
        <text class="value" selectable>{{header.address}}</text>
      </view>
      <view class="info-item" wx:if="{{header.phone}}">
        <text class="label">电话号码</text>
        <text class="value" selectable>{{header.phone}}</text>
      </view>
      <view class="info-item" wx:if="{{header.bank}}">
        <text class="label">开户银行</text>
        <text class="value" selectable>{{header.bank}}</text>
      </view>
      <view class="info-item" wx:if="{{header.bankAccount}}">
        <text class="label">银行账户</text>
        <text class="value" selectable>{{header.bankAccount}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮：分享和复制对所有人可见 -->
  <view class="action-area">
    <button class="action-btn share-btn" open-type="share">分享给好友</button>
    <button class="action-btn copy-btn" bindtap="onCopy">复制完整信息</button>
    <!-- 仅所有者显示编辑 -->
    <button class="action-btn edit-btn" wx:if="{{showActions}}" bindtap="onEdit">编辑</button>
  </view>

  <!-- 仅所有者显示删除 -->
  <view class="delete-area" wx:if="{{showActions}}">
    <text class="delete-btn" bindtap="onDelete">删除此抬头</text>
  </view>
</view>
