.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 0 0 40rpx;
}

.page-title {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  text-align: center;
  padding: 60rpx 0 40rpx;
}

/* 抬头卡片 */
.header-card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 30rpx;
}

.company-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.tag {
  font-size: 26rpx;
  color: #3B5BDB;
  background: rgba(59, 91, 219, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  margin-left: 20rpx;
}

/* 纯文本卡片（分享模式） */
.plain-text-card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.plain-text {
  font-size: 34rpx;
  color: #333;
  line-height: 1.8;
  font-family: monospace;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.label {
  font-size: 28rpx;
  color: #999;
}

.value {
  font-size: 34rpx;
  color: #333;
  font-weight: 500;
  word-break: break-all;
}

/* 操作按钮 */
.action-area {
  margin: 40rpx 30rpx 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 34rpx;
  text-align: center;
  border: none;
}

.action-btn::after {
  border: none;
}

.share-btn {
  background: #3B5BDB;
  color: #fff;
}

.copy-btn {
  background: #fff;
  color: #333;
  border: 1rpx solid #e0e0e0;
}

.edit-btn {
  background: #f5f5f5;
  color: #333;
}

/* 删除区域 */
.delete-area {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.delete-btn {
  font-size: 32rpx;
  color: #fa5151;
}
